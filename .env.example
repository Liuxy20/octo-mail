# Core service and storage. Replace every credential before deployment.
OCTO_MAIL_DSN=postgres://octo_mail:change-me@postgres:5432/octo_mail?sslmode=require
OCTO_MAIL_HOSTNAME=mail.imocto.cn
OCTO_MAIL_NODE_ID=octo-mail-1
OCTO_MAIL_S3_ENDPOINT=https://s3.internal.example
OCTO_MAIL_S3_REGION=us-east-1
OCTO_MAIL_S3_BUCKET=octo-mail
OCTO_MAIL_S3_ACCESS=
OCTO_MAIL_S3_SECRET=
OCTO_MAIL_ADMIN_TOKEN=

# Shared with octo-server. Generate at least 32 random bytes and keep it out of
# source control.
OCTO_MAIL_GATEWAY_SECRET=

# One deployment-wide total-message limit, in bytes. SMTP, IMAP, JMAP, WebAPI,
# and Agent Mail rule forwarding all use this value.
OCTO_MAIL_MAX_SIZE=52428800

# Agent-to-Agent automatic-reply chains are enabled by default. Generate a
# deployment-specific key with: openssl rand -hex 32. All instances must share
# the same value.
OCTO_MAIL_AUTO_REPLY_MAX_COUNT=4
OCTO_MAIL_AUTO_REPLY_CHAIN_KEY=

# Maximum Agent mailboxes for one owner in one OCTO Space, including the
# gateway default Agent mailbox and any additionally registered mailboxes.
OCTO_MAIL_MAX_AGENT_MAILBOXES_PER_OWNER_SPACE=2

# Comma-separated terms that route matching Agent sends to an owner-review
# Draft instead of Sent/queue side effects. Empty disables keyword review.
OCTO_MAIL_OUTBOUND_REVIEW_TERMS=

# Tenant-owned address domain assigned to newly registered Agent mailboxes.
# Provision the same domain in octo-mail before allowing mailbox creation.
OCTO_MAIL_AGENT_MAILBOX_DOMAIN=mail.imocto.cn

# Public JMAP base advertised in the RFC 8620 Session resource. When octo-mail
# is reached through OCTO, include the Agent Mail gateway prefix.
OCTO_MAIL_JMAP_BASEURL=https://octo.example.com/agent-mail-api

# Public browser page used by Agent mailbox device authorization. Keep this on
# the same origin as the OCTO web app so the existing signed-in session and
# Space context are preserved.
OCTO_MAIL_AUTHORIZATION_URL=https://octo.example.com/mail/authorize
